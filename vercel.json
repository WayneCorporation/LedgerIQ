{
  "functions": {
    "api/index.js": {
      "includeFiles": "{index.html,landing.html,privacy.html,terms.html,api.html,app.js,styles.css,marketing.css,enterprise-marketing.css,legal.css}"
    },
    "api/cron.js": {
      "includeFiles": "{index.html,landing.html,privacy.html,terms.html,api.html,app.js,styles.css,marketing.css,enterprise-marketing.css,legal.css}"
    }
  },
  "routes": [
    { "src": "/api/cron", "dest": "/api/cron" },
    { "src": "/(.*)", "dest": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "0 3 * * *" }
  ]
}
